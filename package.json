{
  "name": "nagool-core",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev": "npm run dev:api",
    "start:api": "tsx apps/api/src/server.ts",
    "build:web": "cd apps/web && npm run build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build": "npm run build:api",
    "start": "npm run start:api",
    "start:api:prod": "node apps/api/dist/server.js",
    "start:web": "npm --prefix apps/web run start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.2",
    "firebase-admin": "^13.6.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
